                    '@keyframes vp-mochi-ab-tail{0%,100%{transform:rotate(0);}20%{transform:rotate(-25deg) translateY(-1px);}42%{transform:rotate(25deg);}64%{transform:rotate(-22deg);}82%{transform:rotate(14deg);}}' +
                    '@keyframes vp-mochi-summary-bounce{0%{transform:translateY(0) scale(1);}22%{transform:translateY(3px) scale(1.08,.9);}52%{transform:translateY(-9px) scale(.94,1.1);}76%{transform:translateY(1px) scale(1.04,.97);}100%{transform:translateY(0) scale(1);}}' +
                    '@keyframes vp-mochi-summary-sparkles{0%{opacity:0;transform:translate(-50%,8px) scale(.6);}28%{opacity:1;}100%{opacity:0;transform:translate(-50%,-20px) scale(1.15);}}' +
                    '@keyframes vp-mochi-fall-asleep{0%{transform:translateY(0) scale(1,1);}20%{transform:translateY(3px) scale(1.08,.88);}52%{transform:translateY(-5px) scale(.95,1.1);}76%{transform:translateY(2px) scale(1.05,.94);}100%{transform:translateY(2px) scale(1,.96);}}' +
                    '@keyframes vp-mochi-close-eyes{0%,24%{transform:scaleY(1);}58%{transform:scaleY(.45);}100%{transform:scaleY(.12);}}' +
                    '@keyframes vp-mochi-sleep-yawn{0%,15%{transform:translateX(-50%) scale(1,1);}34%,62%{transform:translateX(-50%) scale(1.2,1.7);}100%{transform:translateX(-50%) scale(1,.55);}}';
                (document.head || document.documentElement).appendChild(playlistMotionStyle);
            }
            if (window.getComputedStyle(wrap).position === 'static') wrap.style.position = 'relative';
            var estilos = VP._mochiEstilos;
            if (estilos && typeof estilos.inyectar === 'function') estilos.inyectar();
            root = document.createElement('div');
            root.className = 'vp-mochi vp-mochi--' + CFG.position;
            var perfil = VP.mochiPerfilActual();
            root.dataset.profile = perfil.id || 'hembra';
            root.setAttribute('aria-label', perfil.ariaLabel || 'Mochi-IA, mascota del reproductor. Haz clic para interactuar');
            root.setAttribute('aria-live', 'polite');
            root.setAttribute('aria-expanded', 'false');
            root.dataset.displayMode = 'normal';
            root.dataset.ollamaStatus = 'idle';
            root.setAttribute('tabindex', '0');
            root.setAttribute('role', 'button');
            if (document.hidden) root.setAttribute('data-motion', 'paused');
            root.innerHTML =
                '<div class="vp-mochi__bubble" role="status" aria-live="polite">' +
                    '<span class="vp-mochi__cerrar" role="button" tabindex="0" aria-label="Cerrar Mochi-IA" title="Cerrar">×</span>' +
                    '<span class="vp-mochi__texto"></span>' +
                '</div>' +
                '<div class="vp-mochi__wrap" aria-hidden="true">' +
                    '<span class="vp-mochi__aura"></span>' +
                    '<span class="vp-mochi__shadow"></span>' +
                    '<div class="vp-mochi__body">' +
                        '<span class="vp-mochi__ollama-indicator" aria-hidden="true"><span class="vp-mochi__ollama-hourglass">⏳</span><span class="vp-mochi__ollama-bulb">💡</span><span class="vp-mochi__ollama-question">?</span></span>' +
                        '<span class="vp-mochi__phase-indicator" aria-hidden="true"></span>' +
                        '<span class="vp-mochi__sweat" aria-hidden="true"></span>' +
                        '<i class="vp-mochi__ear vp-mochi__ear--left"></i>' +
                        '<i class="vp-mochi__ear vp-mochi__ear--right"></i>' +
                        '<span class="vp-mochi__profile-accessory">' + (perfil.accesorio || '') + '</span>' +
                        '<span class="vp-mochi__tail"></span>' +
                        '<span class="vp-mochi__face">' +
                            '<i class="vp-mochi__eye vp-mochi__eye--left"></i>' +
                            '<i class="vp-mochi__eye vp-mochi__eye--right"></i>' +
                            '<i class="vp-mochi__cheek vp-mochi__cheek--left"></i>' +
                            '<i class="vp-mochi__cheek vp-mochi__cheek--right"></i>' +
                            '<i class="vp-mochi__nose"></i>' +
                            '<i class="vp-mochi__mouth"></i>' +
                        '</span>' +
                        '<span class="vp-mochi__shine"></span>' +
                    '</div>' +
                    '<span class="vp-mochi__name">' + (perfil.nombre || 'Mochi') + ' ♡</span>' +
                    '<span class="vp-mochi__particles"></span>' +
                '</div>';
            wrap.appendChild(root);
            asegurarIndicadoresOllama();
            bubble = root.querySelector('.vp-mochi__bubble');
            textoEl = root.querySelector('.vp-mochi__texto');
            particlesEl = root.querySelector('.vp-mochi__particles');
            var cerrarBtn = root.querySelector('.vp-mochi__cerrar');
            var bodyEl = root.querySelector('.vp-mochi__wrap');
            if (cerrarBtn) {
                cerrarBtn.addEventListener('click', onCerrarClick);
                cerrarBtn.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); onCerrarClick(e); } });
            }
            if (bodyEl) {
                bodyEl.addEventListener('click', onBodyClick);
                bodyEl.addEventListener('dblclick', onDoubleClick);
                bodyEl.addEventListener('mouseenter', onBodyMouseEnter);
                bodyEl.addEventListener('mouseleave', onBodyMouseLeave);
            }
            root.addEventListener('keydown', onKeydown);
            root.addEventListener('focus', function () {
                ultimoFocoExterno = document.activeElement;
            });
            root.addEventListener('blur', function () { /* no-op */ });
            root.addEventListener('click', function (e) {
                // si el clic viene del wrap ya se manejó; evita doble disparo
                if (e.target.closest && e.target.closest('.vp-mochi__wrap')) return;
                // clic en el contenedor vacío no hace nada
            });
            if (typeof ResizeObserver !== 'undefined') {
                resizeObserver = new ResizeObserver(debounce(position, 120));
                resizeObserver.observe(wrap);
            }
            function actualizarVisibilidad() {
                var controles = wrap.querySelector('.video-controls');
                var visibles = wrap.classList.contains('show-controls') ||
                    wrap.classList.contains('user-active') ||
                    (controles && controles.classList.contains('always-visible'));
                root.classList.toggle('vp-mochi--controls-hidden', !visibles);
            }
            actualizarVisibilidad();
            if (typeof MutationObserver !== 'undefined') {
                var controlsObserver = new MutationObserver(actualizarVisibilidad);
                controlsObserver.observe(wrap, { attributes: true, attributeFilter: ['class'] });
                limpiarInteraccionesUI = function () { controlsObserver.disconnect(); };
            }
            window.addEventListener('resize', position);
            document.addEventListener('fullscreenchange', position);
            position();
            scheduleIdleGesture();
            return true;
        }
        function position() {
            if (!root) return;
            root.classList.remove('vp-mochi--top-left', 'vp-mochi--top-right', 'vp-mochi--bottom-left', 'vp-mochi--bottom-right');
            root.classList.add('vp-mochi--' + CFG.position);
        }
        // Duraciones alineadas con los keyframes. Los estados sostenidos
        // permanecen activos hasta que la lógica del reproductor los cambie.
        var DURACION_ESTADO = {
            poke: { duracion: 550, tipo: 'once' },
            poke_doble: { duracion: 680, tipo: 'once' },
            susto: { duracion: 900, tipo: 'once' },
            estirando: { duracion: 1200, tipo: 'once' },
            despertando: { duracion: 1000, tipo: 'once' },
            cambiandoSiguiente: { duracion: 860, tipo: 'once' },
            cambiandoAnterior: { duracion: 860, tipo: 'once' },
            videoNuevo: { duracion: 1300, tipo: 'once' },
            despertarReanudacion: { duracion: 1000, tipo: 'once' },
            celebrandoResumen: { duracion: 1200, tipo: 'once' },
            celebrandoCaptura: { duracion: 1300, tipo: 'once' },
            pensativaComentarios: { duracion: 1500, tipo: 'once' },
            sorpresaComentarios: { duracion: 1100, tipo: 'once' },
            mirandoModo: { duracion: 1400, tipo: 'once' },
            deslumbradaHDR: { duracion: 1600, tipo: 'once' },
            repetirControl: { duracion: 900, tipo: 'once' },
            aleatorioControl: { duracion: 1000, tipo: 'once' },
            abRepeatControl: { duracion: 1200, tipo: 'once' },
            detectandoCapitulos: { duracion: 1500, tipo: 'once' },
            entendiendoTraduccion: { duracion: 900, tipo: 'once' },
            sorpresaTraduccion: { duracion: 1000, tipo: 'once' },
            cerrandoChat: { duracion: 700, tipo: 'once' },
            desactivandoLectura: { duracion: 600, tipo: 'once' },
            asombrada: { duracion: 950, tipo: 'once' },
            asombrado: { duracion: 950, tipo: 'once' },
            sorpresa: { duracion: 620, tipo: 'once' },
            saludando: { duracion: 3000, tipo: 'once' },
            curioso: { duracion: 1000, tipo: 'once' },
            curiosa: { duracion: 4200, tipo: 'sostenido' },
            sorprendida: { duracion: 850, tipo: 'once' },
            celebrando: { duracion: 3300, tipo: 'once' },
            somnolienta: { duracion: 4400, tipo: 'sostenido' },
            somnoliento: { duracion: 4400, tipo: 'sostenido' },
            juguetona: { duracion: 3200, tipo: 'sostenido' },
            mimosa: { duracion: 4800, tipo: 'sostenido' },
            despidiendo: { duracion: 950, tipo: 'sostenido' },
            acariciada_largo: { duracion: 3200, tipo: 'once' },
            enamorada: { duracion: 1150, tipo: 'once' },
            enamorado: { duracion: 1150, tipo: 'once' },
            timida: { duracion: 2400, tipo: 'sostenido' },
            timido: { duracion: 1600, tipo: 'sostenido' },
            orgullosa: { duracion: 1600, tipo: 'sostenido' },
            orgulloso: { duracion: 2400, tipo: 'sostenido' },
            confundida: { duracion: 1900, tipo: 'sostenido' },
            confundido: { duracion: 1800, tipo: 'sostenido' },
            aburrida: { duracion: 3600, tipo: 'sostenido' },
            aburrido: { duracion: 2400, tipo: 'sostenido' },
            tension: { duracion: 600, tipo: 'once' },
            ternura: { duracion: 1400, tipo: 'once' },
            nostalgia: { duracion: 4400, tipo: 'sostenido' },
            dormitando: { duracion: 1800, tipo: 'once' }
        };
        var MARGEN_ESTADO_MS = 40;
        var ultimaVarianteConversacion = 0;
        var HUMORES_CON_ANIMACION_PROPIA = ['triste', 'enojado', 'feliz', 'intrigado'];
        function asignarVarianteConversacion() {
            if (!root) return;
            if (HUMORES_CON_ANIMACION_PROPIA.indexOf(root.dataset.mood) !== -1) {
                root.removeAttribute('data-talk-variant');
                return;
            }
            var anterior = Number(ultimaVarianteConversacion);
            if (!isFinite(anterior) || anterior < 1 || anterior > 35 || Math.floor(anterior) !== anterior) anterior = 0;

            var aleatorio = Math.random();
            if (!isFinite(aleatorio) || aleatorio < 0) aleatorio = 0;
            if (aleatorio >= 1) aleatorio = 0.999999999;

            // La primera vez elige entre 35 variantes. Después evita repetir la anterior.
            var opcion = anterior ? 1 + Math.floor(aleatorio * 34) : 1 + Math.floor(aleatorio * 35);
            if (anterior && opcion >= anterior) opcion++;
            ultimaVarianteConversacion = opcion;
            root.dataset.talkVariant = String(opcion);
        }
        function estadoDisponible(name) {
            return !!DURACION_ESTADO[estadoPerfil(name)];
        }
        function state(name, sinGestoReposo, opciones) {
            if (ocultoManualmente || !ensure()) return;
            name = estadoPerfil(name);
            if (name === 'hablando' && root.dataset.ollamaStatus !== 'idle') {
                VP.mochiMascota.setOllamaStatus('idle');
            }
            if (name !== 'idle' && gestureTimer) {
                clearTimeout(gestureTimer);
                gestureTimer = null;
            }
            // no interrumpir poke/enamorado muy breve si ya está en hablando
            if (name !== 'hablando' && name !== 'poke' && name !== 'enamorado') {
                if (typingTimer) clearInterval(typingTimer);
                if (hideTimer) clearTimeout(hideTimer);
                typingTimer = hideTimer = null;
                if (bubble) bubble.classList.remove('is-open');
            }
            if (name !== 'hablando') root.removeAttribute('data-sleepy-speaking');
            if (videoChangeIntentTimer) { clearTimeout(videoChangeIntentTimer); videoChangeIntentTimer = null; }
            root.removeAttribute('data-video-change-intent');
            root.dataset.state = name;
            if (name === 'hablando') asignarVarianteConversacion();
            root.classList.add('is-visible');
            if (name === 'hablando') root.setAttribute('aria-expanded', 'true');
            else root.setAttribute('aria-expanded', 'false');
            if (pokeTimer) { clearTimeout(pokeTimer); pokeTimer = null; }
            var info = DURACION_ESTADO[name];
            if (info && (info.tipo === 'once' || Number(opciones && opciones.duracion) > 0)) {
                pokeTimer = setTimeout(function () {
                    if (!root || root.dataset.state !== name) return;
                    var siguiente = opciones && opciones.siguienteEstado;
                    var video = videoActual();
                    if (!siguiente && name === 'despertando' && video && !video.paused && !video.ended) siguiente = 'estirando';
                    if (siguiente) state(siguiente, true, opciones && opciones.siguienteDuracion ? { duracion: opciones.siguienteDuracion } : undefined);
                    else volverAlReposo(true);
                    if (opciones && typeof opciones.alTerminar === 'function') opciones.alTerminar();
                }, (Number(opciones && opciones.duracion) || info.duracion) + MARGEN_ESTADO_MS);
            }
            if (name === 'idle' && sinGestoReposo !== true) scheduleIdleGesture();
        }
        function setMood(name) {
            if (ocultoManualmente || !ensure()) return;
            var antes = estadoAnimacionDiagnostico();
            var perfil = VP.mochiPerfilActual ? VP.mochiPerfilActual() : {};
            if (perfil.humor && typeof perfil.humor.aplicar === 'function') {
                perfil.humor.aplicar(root, name);
            }
            logAnimacionDiagnostico('setMood(' + String(name || '') + ')', antes, estadoAnimacionDiagnostico());
        }
        function type(text) {
            if (typingTimer) clearInterval(typingTimer);
            if (!bubble || !textoEl) return;
            bubble.classList.add('is-open');
            spawnParticles('star');
            if (CFG.respectReducedMotion && reducedMotion()) {
                textoEl.textContent = text;
            } else {
                textoEl.textContent = '';
                var i = 0;
                typingTimer = setInterval(function () {
                    if (!textoEl || !root || root.dataset.state !== 'hablando') { clearInterval(typingTimer); typingTimer = null; return; }
                    textoEl.textContent += text.charAt(i++);
                    if (i >= text.length) { clearInterval(typingTimer); typingTimer = null; }
                }, Math.max(5, Number(VP.mochiParametro('typewriterMs')) || 22));
            }
            if (hideTimer) clearTimeout(hideTimer);
            hideTimer = setTimeout(function () {
                if (root && root.dataset.state === 'hablando') finalizarHabla();
            }, Math.max(2000, Number(VP.mochiParametro('bubbleDurationMs')) || 9500));
        }
        function scheduleIdleGesture() {
            if (gestureTimer) { clearTimeout(gestureTimer); gestureTimer = null; }
            if (!VP.mochiParametro('idleGestures') || !root || ocultoManualmente || document.hidden ||
                    root.dataset.state !== 'idle' || (CFG.respectReducedMotion && reducedMotion())) return;
            var delay = 4200 + Math.random() * 4800;
            gestureTimer = setTimeout(function () {
                gestureTimer = null;
                if (!root || ocultoManualmente || document.hidden || root.dataset.state !== 'idle') return;
                var pool = CFG.genero === 'hembra'
                    ? ['curiosa', 'juguetona', 'sorprendida', 'celebrando', 'somnolienta', 'dormitando', 'estirando',
                       'timida', 'orgullosa', 'confundida', 'aburrida', 'nostalgia']
                    : ['curioso', 'estirando', 'poke'];
                var gesto = U.seleccionarFraseSesion
                    ? U.seleccionarFraseSesion(pool, CFG.genero, 'gestos_idle')
                    : pickRandom(pool);
                state(gesto);
                if (gesto === 'curioso' || gesto === 'curiosa' || gesto === 'celebrando') spawnParticles('star');
            }, delay);
        }
        function onBodyClick(e) {
            if (e) e.stopPropagation();
            if (VP.mochiScheduler && typeof VP.mochiScheduler.estado === 'function') {
                var schedulerEstado = VP.mochiScheduler.estado();
                if (schedulerEstado.disyuntorAbierto && typeof VP.mochiScheduler.despertarPorClic === 'function' && VP.mochiScheduler.despertarPorClic()) {
                    state('despertando');
                    hablarLocal(CFG.genero === 'macho' ? 'Lo intento una vez más.' : 'Lo intentaré una vez más, aquí voy.', 2600);
                    return;
                }
            }
            var videoParaClick = videoActual();
            if (CFG.genero === 'macho' && (!videoParaClick || videoParaClick.paused || videoParaClick.ended)) {
                VP.mochiMascota.dormir();
                return;
            }
            if (!VP.mochiParametro('clickReactions')) return;
            var now = Date.now();
            var msDesdeUltimoClic = now - lastPatTime;
            if (msDesdeUltimoClic > 0 && msDesdeUltimoClic < 160 && estadoDisponible('susto')) {
                lastPatTime = now;
                spawnParticles('star');
                var fraseSusto = frasePerfil('susto', []);
                state('susto', true, fraseSusto ? {
                    alTerminar: function () { hablarLocal(fraseSusto, 3600); }
                } : undefined);
                return;
            }
            // anti-spam suave
            if (msDesdeUltimoClic < 320) return;
            // racha: caricias seguidas y a buen ritmo (cada una a ≤1.5s de la
            // anterior) llevan a una caricia larga en vez de la reacción corta.
            rachaCaricias = (lastPatTime > 0 && msDesdeUltimoClic <= 1500) ? rachaCaricias + 1 : 1;
            lastPatTime = now;
            var primeraCaricia = patCount === 0;
            patCount++;
            if (primeraCaricia) {
                // Saludo o reacción suave la primera vez que el usuario la toca
                // en la sesión: refuerza el vínculo sin interrumpir el video.
                var perfilInicial = VP.mochiPerfilActual ? VP.mochiPerfilActual() : {};
                if (perfilInicial && perfilInicial.frases && perfilInicial.frases.primerToque) {
                    var frasePrimera = frasePerfil('primerToque', []);
                    if (frasePrimera) hablarLocal(frasePrimera, 3200);
                }
            }
            if (rachaCaricias >= 3 && estadoDisponible('acariciada_largo')) {
                rachaCaricias = 0;
                spawnParticles('heart');
                hablarLocal(frasePerfil('caricias', []), 4200);
                state('acariciada_largo');
                spawnParticles('heart');
                return;
            }
            if (patCount % 7 === 0) {
                // easter egg cada 7 caricias
                spawnParticles('heart');
                hablarLocal(frasePerfil('caricias', []), 4200);
                state('enamorado');
                spawnParticles('heart');
                return;
            }
            spawnParticles('heart');
            state('enamorado');
            // 35% de las veces dice algo tierno local, sin usar Ollama
            if (Math.random() < 0.35) {
                var frase = frasePerfil('caricias', []);
                // no pises una burbuja de Ollama si está hablando
                if (!root || root.dataset.state !== 'hablando') {
                    hablarLocal(frase, 3800);
                }
            }
        }
        function onDoubleClick(e) {
            if (e) e.stopPropagation();
            spawnParticles('star');
            spawnParticles('heart');
            state(CFG.genero === 'hembra' ? 'poke_doble' : 'saludando');
            if (Math.random() < 0.5) {
                hablarLocal('¡Yay! ¡Doble mimitos! ✨', 3600);
            }
        }
        function onBodyMouseEnter() {
            if (ocultoManualmente || !root || document.hidden) return;
            if (CFG.respectReducedMotion && reducedMotion()) return;
            if (root.dataset.state !== 'idle') return;
            if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            hoverActivo = true;
            var gestoHover = CFG.genero === 'macho' ? 'curioso' : 'curiosa';
            state(gestoHover, true);
            hoverTimer = setTimeout(function () {
                hoverTimer = null;
                if (hoverActivo && root && (root.dataset.state === 'curiosa' || root.dataset.state === 'curioso')) {
                    hoverActivo = false;
                    volverAlReposo(true);
                }
            }, 2600);
        }
        function onBodyMouseLeave() {
            if (hoverTimer) { clearTimeout(hoverTimer); hoverTimer = null; }
            if (!hoverActivo) return;
            hoverActivo = false;
            if (root && (root.dataset.state === 'curiosa' || root.dataset.state === 'curioso')) volverAlReposo();
        }
        function hablarLocal(text, durationMs) {
            if (ocultoManualmente || !ensure()) return;
            if (typingTimer) clearInterval(typingTimer);
            if (hideTimer) clearTimeout(hideTimer);
            if (VP.mochiMascota && typeof VP.mochiMascota.setOllamaStatus === 'function') {
                VP.mochiMascota.setOllamaStatus('idle');
            }
            root.removeAttribute('data-sleepy-speaking');
            root.dataset.state = 'hablando';
            asignarVarianteConversacion();
            root.classList.add('is-visible');
            root.setAttribute('aria-expanded', 'true');
            bubble.classList.add('is-open');
            if (CFG.respectReducedMotion && reducedMotion()) {
                textoEl.textContent = text;
            } else {
                textoEl.textContent = '';
                var i = 0;
                typingTimer = setInterval(function () {
                    if (!textoEl || !root) { clearInterval(typingTimer); typingTimer = null; return; }
                    textoEl.textContent += String(text).charAt(i++);
                    if (i >= String(text).length) { clearInterval(typingTimer); typingTimer = null; }
                }, Math.max(5, Number(VP.mochiParametro('typewriterMs')) || 22));
            }
            spawnParticles('star');
            hideTimer = setTimeout(function () {
                if (root && root.dataset.state === 'hablando') finalizarHabla();
                else {
                    if (bubble) bubble.classList.remove('is-open');
                    if (root) root.setAttribute('aria-expanded', 'false');
                }
            }, durationMs || 4200);
        }
        VP.mochiMascota = {
            setState: state,
            anticiparCambioVideo: function (direccion) {
                if (direccion !== 'siguiente' && direccion !== 'anterior') return false;
                if (!ensure()) return false;
                if (videoChangeIntentTimer) clearTimeout(videoChangeIntentTimer);
                root.dataset.videoChangeIntent = direccion;
                videoChangeIntentTimer = setTimeout(function () {
                    videoChangeIntentTimer = null;
                    if (root && root.dataset.videoChangeIntent === direccion) root.removeAttribute('data-video-change-intent');
                }, 2400);
                return true;
            },
            estaHablando: function () { return !!(root && root.dataset.state === 'hablando'); },
            prepararSuenoDuranteHabla: function () {
                if (!root || root.dataset.state !== 'hablando') return false;
                root.setAttribute('data-sleepy-speaking', 'true');
                return true;
            },
            celebrar: function (duracion) {
                state('celebrandoResumen', true, { duracion: Number(duracion) || 1200 });
                spawnParticles('star');
            },
            posarFotograma: function () {
                state('posandoFotograma', true);
            },
            celebrarCaptura: function () {
                state('celebrandoCaptura', true, { duracion: 1300 });
                spawnParticles('star');
            },
            pensarComentarios: function () {
                state('pensativaComentarios', true, { duracion: 1500 });
            },
            sorprenderComentarios: function () {
                state('sorpresaComentarios', true, { duracion: 1100 });
                spawnParticles('star');
            },
            cambiarModo: function (modo) {
                var duraciones = { normal: 1400, pip: 1000, fullscreen: 1200, cine: 1200 };
                if (!Object.prototype.hasOwnProperty.call(duraciones, modo) || !ensure()) return false;
                if (root.dataset.displayMode === modo) return false;
                root.dataset.displayMode = modo;
                root.style.setProperty('--vp-mochi-mode-duration', (duraciones[modo] / 1000) + 's');
                state('mirandoModo', true, { duracion: duraciones[modo], siguienteEstado: 'idle' });
                return true;
            },
            cambiarHDR: function (activo, animar) {
                if (activo !== true && !root) return false;
                if (!ensure()) return false;
                var encendido = activo === true;
                root.dataset.hdr = encendido ? 'on' : 'off';
                if (encendido && animar !== false) {
                    state('deslumbradaHDR', true, { duracion: 1600, siguienteEstado: 'idle' });
                } else if (!encendido && root.dataset.state === 'deslumbradaHDR') {
                    state('idle', true);
                }
                return true;
            },
            reaccionControlReproduccion: function (tipo) {
                var estados = { repetir: 'repetirControl', aleatorio: 'aleatorioControl', ab: 'abRepeatControl' };
                var duraciones = { repetir: 900, aleatorio: 1000, ab: 1200 };
                if (!estados[tipo]) return false;
                state(estados[tipo], true, { duracion: duraciones[tipo], siguienteEstado: 'idle' });
                if (tipo === 'aleatorio') spawnParticles('star');
                return true;
            },
            detectarCapitulos: function () {
                state('detectandoCapitulos', true, { duracion: 1460 });
                spawnParticles('star');
            },
            iniciarConversacion: function () {
                state('conversando', true);
                spawnParticles('star');
            },
            cerrarConversacion: function () {
                state('cerrandoChat', true, { duracion: 660, siguienteEstado: 'idle' });
            },
            entenderTraduccion: function () {
                var siguiente = VP.estado && VP.estado.subtitulosActivos ? 'leyendo' : 'idle';
                state('entendiendoTraduccion', true, { duracion: 860, siguienteEstado: siguiente });
            },
            sorpresaTraduccion: function () {
                var siguiente = VP.estado && VP.estado.subtitulosActivos ? 'leyendo' : 'idle';
                state('sorpresaTraduccion', true, { duracion: 960, siguienteEstado: siguiente });
            },
            setTechnicalState: function (phase, detail) {
                if (!root) return;
                // Si el disyuntor se abre justo después del error, conserva la
                // gota hasta que complete sus 2,35 s aunque cambie la pose a sueño.
                var conservarGota = phase === 'COOLDOWN' && root.dataset.techDetail === 'ollama-unavailable' && !!technicalDetailTimer;
                root.dataset.techState = phase;
                if (technicalPoseTimer) { clearTimeout(technicalPoseTimer); technicalPoseTimer = null; }
                if (technicalDetailTimer && !conservarGota) { clearTimeout(technicalDetailTimer); technicalDetailTimer = null; }
                root.removeAttribute('data-tech-pose');
                if (!conservarGota) root.removeAttribute('data-tech-detail');
                var durations = { CONTEXT_READY: 800, REQUESTING_OLLAMA: 600, WAITING_OLLAMA: 600, PROCESSING_RESPONSE: 2600, WAITING_TIMING: 2800, COOLDOWN: 3000, ERROR: 800 };
                var duration = durations[phase];
                if (!duration) return;
                root.dataset.techPose = phase === 'WAITING_OLLAMA' ? 'REQUESTING_OLLAMA' : phase;
                if (phase === 'ERROR') {
                    var cause = String(detail || '').toLowerCase();
                    var noDisponible = /ollama_unavailable|conn_refused|econnrefused|connection refused|actively refused|conexi[oó]n rechazada|conexi[oó]n rehusada/.test(cause);
                    root.dataset.techDetail = noDisponible ? 'ollama-unavailable' : (/timeout|tiempo de espera|agotado/.test(cause) ? 'timeout' : (/vac[ií]a|vacia|empty|sin texto/.test(cause) ? 'empty' : (/network|red|fetch|conexi[oó]n|ollama/.test(cause) ? 'connection' : 'error')));
                    if (noDisponible) {
                        technicalDetailTimer = setTimeout(function () {
                            technicalDetailTimer = null;
                            if (root) root.removeAttribute('data-tech-detail');
                        }, 2350);
                    }
                }
                // La pose es solo visual: su expiración no participa del scheduler.
                technicalPoseTimer = setTimeout(function () {
                    technicalPoseTimer = null;
                    if (!root) return;
                    root.removeAttribute('data-tech-pose');
                    if (root.dataset.techDetail !== 'ollama-unavailable') root.removeAttribute('data-tech-detail');
                }, duration);
            },
            clearTechnicalState: function () {
                if (technicalPoseTimer) { clearTimeout(technicalPoseTimer); technicalPoseTimer = null; }
                if (technicalDetailTimer) { clearTimeout(technicalDetailTimer); technicalDetailTimer = null; }
                if (root) { root.removeAttribute('data-tech-pose'); root.removeAttribute('data-tech-detail'); root.removeAttribute('data-tech-state'); }
            },
            setOllamaStatus: function (status) {
                if (!ensure()) return;
                if (ollamaStatusTimer) { clearTimeout(ollamaStatusTimer); ollamaStatusTimer = null; }
                if (root.dataset.state === 'hablando' && status === 'respuesta') status = 'idle';
                var indicador = asegurarIndicadoresOllama();
                root.dataset.ollamaStatus = status === 'waiting' || status === 'respuesta' || status === 'invalida' ? status : 'idle';
                if (root.dataset.ollamaStatus === 'respuesta') {
                    // El bombillo señala una respuesta nueva brevemente; no
                    // debe quedar encendido hasta la siguiente frase de Mochi.
                    ollamaStatusTimer = setTimeout(function () {
                        ollamaStatusTimer = null;
                        if (root && root.dataset.ollamaStatus === 'respuesta') {
                            root.dataset.ollamaStatus = 'idle';
                        }
                    }, 3000);
                }
                if (indicador) {
                    var animados = [indicador].concat(Array.prototype.slice.call(indicador.children));
                    animados.forEach(function (elemento) { elemento.style.setProperty('animation', 'none', 'important'); });
                    void indicador.offsetWidth;
                    animados.forEach(function (elemento) { elemento.style.removeProperty('animation'); });
                }
            },
            setMood: setMood,
            setMotionPaused: function (paused) {
                if (!root) return;
                if (paused) root.setAttribute('data-motion', 'paused');
                else if (root.getAttribute('data-motion') === 'paused') root.removeAttribute('data-motion');
            },
            setGender: function (gender) {
                var anterior = CFG.genero;
                CFG.genero = gender === 'macho' ? 'macho' : 'hembra';
                var perfil = VP.mochiPerfiles[CFG.genero] || VP.mochiPerfilActual();
                if (VP._mochiEstilos) VP._mochiEstilos.inyectar();
                if (root) {
                    root.dataset.profile = perfil.id || 'hembra';
                    var accesorio = root.querySelector('.vp-mochi__profile-accessory');
                    var nombre = root.querySelector('.vp-mochi__name');
                    if (accesorio) accesorio.innerHTML = perfil.accesorio || '';
                    if (nombre) nombre.textContent = (perfil.nombre || 'Mochi') + ' ♡';
                    root.setAttribute('aria-label', perfil.ariaLabel || 'Mochi-IA, mascota del reproductor. Haz clic para interactuar');
                    if (anterior !== CFG.genero) {
                        if (pokeTimer) clearTimeout(pokeTimer);
                        root.dataset.state = 'idle';
                    } else {
                        root.dataset.state = estadoPerfil(root.dataset.state || 'idle');
                    }
                }
                if (anterior !== CFG.genero && VP.mochiScheduler) VP.mochiScheduler.reset();
            },
            hablar: function (text, mood) {
                if (pokeTimer) { clearTimeout(pokeTimer); pokeTimer = null; }
                setMood(mood);
                var gestoPrevio = {
                    feliz: 'celebrando',
                    triste: 'ternura',
                    enojado: 'tension',
                    curioso: 'asombrada'
                }[mood];
                var perfilActual = VP.mochiPerfilActual ? VP.mochiPerfilActual() : {};
                var estadosPerfil = Array.isArray(perfilActual.estados) ? perfilActual.estados : [];
                var textoFinal = String(text || '');
                if (gestoPrevio && estadosPerfil.indexOf(gestoPrevio) !== -1) {
                    state(gestoPrevio, true, {
                        siguienteEstado: 'hablando',
                        alTerminar: function () { type(textoFinal); }
                    });
                } else {
                    state('hablando');
                    type(textoFinal);
                }
            },
            mostrarAviso: function (text) {
                if (pokeTimer) { clearTimeout(pokeTimer); pokeTimer = null; }
                state('hablando');
                type(String(text || ''));
            },
            hablarLocal: hablarLocal,
            acariciar: onBodyClick,
            dormir: function () {
                if (gestureTimer) clearTimeout(gestureTimer);
                if (CFG.genero === 'hembra') state('dormitando', true, { siguienteEstado: 'durmiendo' });
                else {
                    if (typeof VP.mochiMascota.cancelarTransicionSueno === 'function') VP.mochiMascota.cancelarTransicionSueno();
                    state('somnoliento', true, { duracion: 1960, siguienteEstado: 'durmiendo' });
                }
            },
            show: function () {
                if (ocultoManualmente) return;
                if (ensure()) { root.classList.add('is-visible'); state('idle'); }
            },
            hide: function (manual) {
                if (manual !== false) ocultoManualmente = true;
                limpiarTimersInterfaz();
                if (root) {
                    root.removeAttribute('data-tech-pose');
                    root.removeAttribute('data-tech-detail');
                    root.removeAttribute('data-tech-state');
                    root.removeAttribute('data-video-change-intent');
                    if (VP.mochiMascota && typeof VP.mochiMascota.setOllamaStatus === 'function') {
                        VP.mochiMascota.setOllamaStatus('idle');
                    }
                }
                if (bubble) bubble.classList.remove('is-open');
                if (root) {
                    root.classList.remove('is-visible');
                    root.setAttribute('aria-expanded', 'false');
                }
            },
            reaccionar: function (categoria) {
                if (ocultoManualmente) return false;
                var frase = frasePerfil(categoria, []);
                if (!frase) return false;
                var estado = categoria === 'clic' || categoria === 'caricias' ? 'enamorado' :
                    categoria === 'curiosidad' ? 'curioso' : categoria;
                state(estado);
                hablarLocal(frase, 4200);
                return true;
            },
            posicionar: function (posicion) {
                var posiciones = ['bottom-right', 'bottom-left', 'top-right', 'top-left'];
                if (posiciones.indexOf(posicion) === -1) return false;
                CFG.position = posicion;
                if (root) {
                    root.classList.remove('vp-mochi--top-left', 'vp-mochi--top-right', 'vp-mochi--bottom-left', 'vp-mochi--bottom-right');
                    root.classList.add('vp-mochi--' + posicion);
                }
                return true;
            },
            despedir: function () {
                if (ocultoManualmente || !ensure()) return;
                if (gestureTimer) clearTimeout(gestureTimer);
                var frase = frasePerfil('despedidas', ['¡Bye! ♡']);
                hablarLocal(frase, 3200);
                root.dataset.state = estadoPerfil('despidiendo');
                if (farewellTimer) clearTimeout(farewellTimer);
                farewellTimer = setTimeout(function () { if (root && root.dataset.state === estadoPerfil('despidiendo')) remove(); }, 3400);
            },
            saludar: function () {
                if (ocultoManualmente || !ensure()) return;
                var frase = frasePerfil('saludos', ['¡Hola! ♡']);
                state('saludando');
                spawnParticles('heart');
                hablarLocal(frase, 3800);
            },
            reiniciarOcultamiento: function () { ocultoManualmente = false; },
            mostrar: function () { ocultoManualmente = false; return this.show(); },
            estaOculto: function () { return ocultoManualmente; },
            destroy: remove
        };
    })(window, document);
