    /* ==========================================================================
       8. DOM, ESTADOS, ANIMACIONES Y PARTÍCULAS
       ========================================================================== */
    (function (window, document) {
        'use strict';
        var VP = window.VP;
        var CFG = VP.mochiConfig;
        var U = VP._mochiUtil || {};
        var debounce = U.debounce || function (fn) { return fn; };
        var reducedMotion = U.prefiereMovimientoReducido || function () { return false; };
        var pickRandom = U.pickRandom || function (a) { return a && a[0] || ''; };

        function frasePerfil(categoria, fallback) {
            var perfil = VP.mochiPerfilActual ? VP.mochiPerfilActual() : {};
            var frases = perfil && perfil.frases && perfil.frases[categoria];
            if (!Array.isArray(frases)) frases = perfil && perfil[categoria];
            if (!Array.isArray(frases) || !frases.length) frases = fallback;
            if (U.seleccionarFraseSesion) return U.seleccionarFraseSesion(frases, perfil.id || CFG.genero, categoria);
            return pickRandom(frases);
        }

        function estadoPerfil(nombre) {
            var perfil = VP.mochiPerfilActual ? VP.mochiPerfilActual() : {};
            var estados = perfil && perfil.estados;
            if (!Array.isArray(estados) || estados.indexOf(nombre) !== -1) return nombre;
            var equivalencias = {
                curioso: 'curiosa', durmiendo: 'dormida', enamorado: 'enamorada',
                poke: 'juguetona', estirando: 'juguetona', despertando: 'estirando',
                despidiendo: 'saludando'
            };
            var equivalente = equivalencias[nombre];
            return equivalente && estados.indexOf(equivalente) !== -1 ? equivalente : nombre;
        }

        function videoActual() {
            return VP.refs && VP.refs.videoPlayer;
        }

        function volverAlReposo(sinGestoReposo) {
            var antes = estadoAnimacionDiagnostico();
            // Un gesto o comentario puede despertar a Mochi mientras el video
            // ya estaba pausado (en ese caso no habrá un nuevo evento pause).
            var video = videoActual();
            if (video && video.paused && !video.ended) state('durmiendo');
            else state('idle', sinGestoReposo === true);
            logAnimacionDiagnostico('volverAlReposo', antes, estadoAnimacionDiagnostico());
        }

        function finalizarHabla() {
            if (bubble) bubble.classList.remove('is-open');
            if (root) root.setAttribute('aria-expanded', 'false');
            if (!root || root.dataset.state !== 'hablando') return;

            if (typingTimer) clearInterval(typingTimer);
            typingTimer = null;
            try { state('idle', true); } catch (_) {}

            // La animación de hablar es infinita en CSS y solo se apaga al
            // abandonar este estado. Al cerrar el globo, Mochi vuelve siempre
            // a idle, aunque el video esté pausado; este respaldo también cubre
            // un fallo de ensure() durante la transición.
            if (root && root.dataset.state === 'hablando') {
                root.dataset.state = estadoPerfil('idle');
                root.setAttribute('aria-expanded', 'false');
                root.removeAttribute('data-sleepy-speaking');
                root.removeAttribute('data-talk-variant');
            }
        }

        var root = null;
        var bubble = null;
        var textoEl = null;
        var particlesEl = null;
        var technicalPoseTimer = null;
        var technicalDetailTimer = null;
        var ollamaStatusTimer = null;
        var typingTimer = null;
        var hideTimer = null;
        var farewellTimer = null;
        var gestureTimer = null;
        var pokeTimer = null;
        var videoChangeIntentTimer = null;
        var resizeObserver = null;
        var limpiarInteraccionesUI = null;
        var ocultoManualmente = false;
        var patCount = 0;
        var lastPatTime = 0;
        var rachaCaricias = 0;
        var hoverTimer = null;
        var hoverActivo = false;
        var ultimoFocoExterno = null;

        function estadoAnimacionDiagnostico() {
            var cuerpo = root && root.querySelector('.vp-mochi__body');
            var estilo = cuerpo && window.getComputedStyle ? window.getComputedStyle(cuerpo) : null;
            return {
                state: root && root.dataset.state || null,
                mood: root && root.dataset.mood || null,
                talkVariant: root && root.dataset.talkVariant || null,
                animationName: estilo ? estilo.animationName : null,
                inlineAnimation: cuerpo && cuerpo.style ? cuerpo.style.animation || '' : ''
            };
        }

        function logAnimacionDiagnostico(evento, antes, despues) {
            if (!root || root.dataset.profile !== 'macho' || !window.console || typeof window.console.info !== 'function') return;
            if (VP_DEBUG.general || VP_DEBUG.Mochi.general || VP_DEBUG.Mochi.animacion) window.console.info('[Mochi animación runtime]', evento, { antes: antes, despues: despues });
        }

        function limpiarTimersInterfaz() {
            if (typingTimer) clearInterval(typingTimer);
            if (hideTimer) clearTimeout(hideTimer);
            if (farewellTimer) clearTimeout(farewellTimer);
            if (gestureTimer) clearTimeout(gestureTimer);
            if (pokeTimer) clearTimeout(pokeTimer);
            if (hoverTimer) clearTimeout(hoverTimer);
            if (videoChangeIntentTimer) clearTimeout(videoChangeIntentTimer);
            if (technicalPoseTimer) clearTimeout(technicalPoseTimer);
            if (technicalDetailTimer) clearTimeout(technicalDetailTimer);
            if (ollamaStatusTimer) clearTimeout(ollamaStatusTimer);
            typingTimer = hideTimer = farewellTimer = gestureTimer = pokeTimer = hoverTimer = null;
            videoChangeIntentTimer = technicalPoseTimer = technicalDetailTimer = null;
            ollamaStatusTimer = null;
            hoverActivo = false;
        }

        function remove() {
            limpiarTimersInterfaz();
            if (resizeObserver) resizeObserver.disconnect();
            resizeObserver = null;
            if (limpiarInteraccionesUI) limpiarInteraccionesUI();
            limpiarInteraccionesUI = null;
            window.removeEventListener('resize', position);
            document.removeEventListener('fullscreenchange', position);
            if (root && root.parentNode) root.parentNode.removeChild(root);
            root = bubble = textoEl = particlesEl = null;
        }
        function onCerrarClick(e) {
            e.stopPropagation();
            ocultoManualmente = true;
            if (VP.mochiMascota && typeof VP.mochiMascota.hide === 'function') VP.mochiMascota.hide();
        }
        function onKeydown(e) {
            if (e.key === 'Escape' && bubble && bubble.classList.contains('is-open')) {
                bubble.classList.remove('is-open');
                state('idle');
                return;
            }
            if (bubble && bubble.classList.contains('is-open')) {
                // Bloqueo suave del foco: el contenedor ya atrapa tab dentro.
                if (e.key === 'Tab') {
                    // Permitido por simplicidad: solo se evita salir del nodo
                    // cuando el foco está en el propio root.
                }
            }
            if ((e.key === 'Enter' || e.key === ' ') && e.target === root) {
                e.preventDefault();
                onBodyClick(e);
            }
        }
        function spawnParticles(kind) {
            if (!VP.mochiParametro('particleEffects') || !particlesEl) return;
            if (CFG.respectReducedMotion && reducedMotion()) return;
            var emojis = kind === 'heart' ? ['♡', '♥', '✦'] : kind === 'star' ? ['✨', '⭐', '✦'] : ['♪', '♡', '✨'];
            var count = kind === 'heart' ? 3 : 2;
            for (var i = 0; i < count; i++) {
                (function (idx) {
                    var el = document.createElement('span');
                    el.className = 'vp-mochi__particle';
                    el.textContent = pickRandom(emojis);
                    el.style.left = (45 + Math.random() * 18) + '%';
                    el.style.top = (6 + Math.random() * 10) + 'px';
                    el.style.fontSize = (12 + Math.random() * 6) + 'px';
                    el.style.animationDelay = (idx * 90) + 'ms';
                    el.style.animationDuration = (820 + Math.random() * 280) + 'ms';
                    particlesEl.appendChild(el);
                    setTimeout(function () { if (el.parentNode) el.parentNode.removeChild(el); }, 1100);
                })(i);
            }
        }
        function asegurarIndicadoresOllama() {
            if (!root) return null;
            var body = root.querySelector('.vp-mochi__body');
            if (!body) return null;
            var indicator = body.querySelector('.vp-mochi__ollama-indicator');
            if (!indicator) {
                indicator = document.createElement('span');
                indicator.className = 'vp-mochi__ollama-indicator';
                indicator.setAttribute('aria-hidden', 'true');
                body.insertBefore(indicator, body.firstChild);
            }
            var items = [
                ['vp-mochi__ollama-hourglass', '⏳'],
                ['vp-mochi__ollama-bulb', '💡'],
                ['vp-mochi__ollama-question', '?']
            ];
            items.forEach(function (item) {
                var icon = indicator.querySelector('.' + item[0]);
                if (!icon) {
                    icon = document.createElement('span');
                    icon.className = item[0];
                    indicator.appendChild(icon);
                }
                if (!icon.textContent || !icon.textContent.trim()) icon.textContent = item[1];
            });
            return indicator;
        }
        function ensure() {
            var wrap = VP.refs && VP.refs.videoPlayerWrap;
            if (!wrap) return false;
            if (root && root.parentNode === wrap) { asegurarIndicadoresOllama(); return true; }
            remove();
            if (!document.getElementById('vp-mochi-motion-pause-style')) {
                var motionStyle = document.createElement('style');
                motionStyle.id = 'vp-mochi-motion-pause-style';
                motionStyle.textContent = '.vp-mochi[data-motion="paused"],.vp-mochi[data-motion="paused"] *, .vp-mochi[data-motion="paused"] *::before, .vp-mochi[data-motion="paused"] *::after{animation-play-state:paused!important;}';
                (document.head || document.documentElement).appendChild(motionStyle);
            }
            if (!document.getElementById('vp-mochi-playlist-motion-style')) {
                var playlistMotionStyle = document.createElement('style');
                playlistMotionStyle.id = 'vp-mochi-playlist-motion-style';
                playlistMotionStyle.textContent =
                    '.vp-mochi[data-state="cambiandoSiguiente"] .vp-mochi__body{animation:vp-mochi-next-tilt .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="cambiandoAnterior"] .vp-mochi__body{animation:vp-mochi-prev-tilt .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-video-change-intent="siguiente"] .vp-mochi__body{animation:vp-mochi-next-anticipate .32s ease-out both!important;}' +
                    '.vp-mochi[data-video-change-intent="anterior"] .vp-mochi__body{animation:vp-mochi-prev-anticipate .32s ease-out both!important;}' +
                    '.vp-mochi[data-state="videoNuevo"] .vp-mochi__body{animation:vp-mochi-video-rebound .8s cubic-bezier(.2,.8,.25,1) both!important;}' +
                    '.vp-mochi[data-state="detectandoCapitulos"] .vp-mochi__body{animation:vp-mochi-detectar-capitulos 1.5s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="detectandoCapitulos"] .vp-mochi__eye{animation:vp-mochi-mirada-capitulos 1.5s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="detectandoCapitulos"] .vp-mochi__particles::before{content:"✦  ✧  ✦";position:absolute;left:50%;top:-5px;color:#a9dcff;font-size:16px;letter-spacing:5px;white-space:nowrap;text-shadow:0 0 8px rgba(134,205,255,.95);animation:vp-mochi-summary-sparkles 1.5s ease-out both;}' +
                    '.vp-mochi[data-state="entendiendoTraduccion"] .vp-mochi__body{animation:vp-mochi-translation-nod .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="entendiendoTraduccion"] .vp-mochi__eye{animation:vp-mochi-translation-look .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="entendiendoTraduccion"] .vp-mochi__ollama-bulb{display:inline-block;filter:drop-shadow(0 0 5px #ffe45e);animation:vp-mochi-translation-bulb .9s ease-in-out both;}' +
                    '.vp-mochi[data-state="sorpresaTraduccion"] .vp-mochi__body{animation:vp-mochi-translation-surprise 1s cubic-bezier(.2,.8,.25,1) both!important;}' +
                    '.vp-mochi[data-state="sorpresaTraduccion"] .vp-mochi__particles::before{content:"?";position:absolute;left:50%;top:-8px;color:#ffe28a;font-size:21px;font-weight:800;text-shadow:0 0 8px rgba(255,220,120,.9);animation:vp-mochi-translation-question 1s ease-out both;}' +
                    '.vp-mochi[data-state="conversando"] .vp-mochi__body{animation:vp-mochi-chat-presence 2.6s ease-in-out infinite;}' +
                    '.vp-mochi[data-state="conversando"] .vp-mochi__face{animation:vp-mochi-chat-entry .8s ease-out both;}' +
                    '.vp-mochi[data-state="conversando"] .vp-mochi__particles::before{content:"✦  ✧";position:absolute;left:50%;top:-5px;color:#a9dcff;font-size:15px;letter-spacing:5px;white-space:nowrap;text-shadow:0 0 8px rgba(134,205,255,.95);animation:vp-mochi-summary-sparkles .8s ease-out both;}' +
                    '.vp-mochi[data-state="cerrandoChat"] .vp-mochi__body{animation:vp-mochi-chat-close .7s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="cerrandoChat"] .vp-mochi__face{animation:vp-mochi-chat-return .7s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="despertarReanudacion"] .vp-mochi__body{animation:vp-mochi-resume-stretch 1s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="despertarReanudacion"] .vp-mochi__eye{animation:vp-mochi-resume-eyes 1s ease-out both!important;}' +
                    '.vp-mochi[data-state="despertarReanudacion"] .vp-mochi__ear{animation:vp-mochi-resume-ears 1s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="celebrandoResumen"] .vp-mochi__body{animation:vp-mochi-summary-bounce 1.2s cubic-bezier(.2,.8,.25,1) infinite!important;}' +
                    '.vp-mochi[data-state="celebrandoResumen"] .vp-mochi__tail{animation:vp-mochi-summary-tail .72s cubic-bezier(.34,1.2,.64,1) infinite!important;}' +
                    '@keyframes vp-mochi-summary-tail{0%,100%{transform:rotate(-18deg) scale(1,1)}34%{transform:rotate(14deg) scale(1.06,.96)}58%{transform:rotate(34deg) scale(1.12,.92)}82%{transform:rotate(-6deg) scale(1.02,.99)}}' +
                    '.vp-mochi[data-state="celebrandoResumen"] .vp-mochi__particles::before{content:"✦  ✧  ✦";position:absolute;left:50%;top:-5px;color:#a9dcff;font-size:16px;letter-spacing:5px;white-space:nowrap;text-shadow:0 0 8px rgba(134,205,255,.95);animation:vp-mochi-summary-sparkles 1.2s ease-out both;}' +
                    '.vp-mochi[data-state="posandoFotograma"] .vp-mochi__body{animation:vp-mochi-frame-pose 1s ease-out both!important;}' +
                    '.vp-mochi[data-state="posandoFotograma"] .vp-mochi__particles::before{content:"✦";position:absolute;left:50%;top:-5px;color:#fff2a8;font-size:17px;text-shadow:0 0 9px #ffe36e;animation:vp-mochi-frame-glint 1s ease-out both;}' +
                    '.vp-mochi[data-state="celebrandoCaptura"] .vp-mochi__body{animation:vp-mochi-summary-bounce 1.3s cubic-bezier(.2,.8,.25,1) both!important;}' +
                    '.vp-mochi[data-state="celebrandoCaptura"] .vp-mochi__particles::before{content:"✦  ✧  ✦";position:absolute;left:50%;top:-5px;color:#fff2a8;font-size:16px;letter-spacing:5px;white-space:nowrap;text-shadow:0 0 9px rgba(255,227,110,.95);animation:vp-mochi-summary-sparkles 1.3s ease-out both;}' +
                    '.vp-mochi[data-state="pensativaComentarios"] .vp-mochi__body{animation:vp-mochi-detectar-capitulos 1.5s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="pensativaComentarios"] .vp-mochi__eye{animation:vp-mochi-mirada-capitulos 1.5s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="sorpresaComentarios"] .vp-mochi__body{animation:vp-mochi-translation-surprise 1.1s cubic-bezier(.2,.8,.25,1) both!important;}' +
                    '.vp-mochi[data-state="sorpresaComentarios"] .vp-mochi__particles::before{content:"!  ✦";position:absolute;left:50%;top:-8px;color:#ffe28a;font-size:19px;font-weight:800;letter-spacing:3px;text-shadow:0 0 8px rgba(255,220,120,.9);animation:vp-mochi-translation-question 1.1s ease-out both;}' +
                    '.vp-mochi__aura{transition:transform .45s ease,opacity .45s ease;}' +
                    '.vp-mochi[data-display-mode="pip"] .vp-mochi__aura{animation:none!important;transform:scale(.72);opacity:.42;}' +
                    '.vp-mochi[data-display-mode="fullscreen"] .vp-mochi__aura{animation:none!important;transform:scale(1.14);opacity:1;}' +
                    '.vp-mochi[data-display-mode="cine"] .vp-mochi__aura{animation:none!important;transform:scale(.86);opacity:.38;}' +
                    '.vp-mochi[data-display-mode="cine"] .vp-mochi__shadow{width:54px;opacity:1;}' +
                    '.vp-mochi[data-state="mirandoModo"] .vp-mochi__body{animation:vp-mochi-mode-look var(--vp-mochi-mode-duration,1.4s) ease-in-out both!important;}' +
                    '.vp-mochi[data-state="mirandoModo"] .vp-mochi__eye{animation:vp-mochi-mode-eyes var(--vp-mochi-mode-duration,1.4s) ease-in-out both!important;}' +
                    '.vp-mochi[data-state="mirandoModo"][data-display-mode="pip"] .vp-mochi__aura{animation:vp-mochi-mode-pip var(--vp-mochi-mode-duration,1s) ease both!important;}' +
                    '.vp-mochi[data-state="mirandoModo"][data-display-mode="fullscreen"] .vp-mochi__aura{animation:vp-mochi-mode-fullscreen var(--vp-mochi-mode-duration,1.2s) ease both!important;}' +
                    '.vp-mochi[data-state="mirandoModo"][data-display-mode="cine"] .vp-mochi__shadow{animation:vp-mochi-mode-theatre var(--vp-mochi-mode-duration,1.2s) ease both!important;}' +
                    '.vp-mochi[data-hdr="on"] .vp-mochi__aura{filter:brightness(1.5) drop-shadow(0 0 7px rgba(255,238,158,.85));}' +
                    '.vp-mochi[data-state="deslumbradaHDR"] .vp-mochi__body{animation:vp-mochi-hdr-flash 1.6s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="deslumbradaHDR"] .vp-mochi__eye{animation:vp-mochi-hdr-eyes 1.6s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="deslumbradaHDR"] .vp-mochi__aura{animation:vp-mochi-hdr-aura 1.6s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="repetirControl"] .vp-mochi__tail{animation:vp-mochi-loop-tail .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="repetirControl"] .vp-mochi__body{animation:vp-mochi-loop-body .9s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="aleatorioControl"] .vp-mochi__eye--left{animation:vp-mochi-shuffle-left 1s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="aleatorioControl"] .vp-mochi__eye--right{animation:vp-mochi-shuffle-right 1s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="aleatorioControl"] .vp-mochi__particles::before{content:"?";position:absolute;left:50%;top:-8px;color:#ffe28a;font-size:21px;font-weight:800;text-shadow:0 0 8px rgba(255,220,120,.9);animation:vp-mochi-translation-question 1s ease-out both;}' +
                    '.vp-mochi[data-state="abRepeatControl"] .vp-mochi__tail{animation:vp-mochi-ab-tail 1.2s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="somnoliento"] .vp-mochi__body,.vp-mochi[data-state="somnolienta"] .vp-mochi__body{animation:vp-mochi-fall-asleep 1.96s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="somnoliento"] .vp-mochi__eye,.vp-mochi[data-state="somnolienta"] .vp-mochi__eye{animation:vp-mochi-close-eyes 1.96s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="somnoliento"] .vp-mochi__mouth,.vp-mochi[data-state="somnolienta"] .vp-mochi__mouth{animation:vp-mochi-sleep-yawn 1.96s ease-in-out both!important;}' +
                    '.vp-mochi[data-state="leyendo"] .vp-mochi__face{animation:vp-mochi-reading-look .8s ease-out both;}' +
                    '.vp-mochi[data-state="leyendo"] .vp-mochi__eye{animation:vp-mochi-reading-eyes .8s ease-out 1 both!important;}' +
                    '.vp-mochi[data-state="leyendo"] .vp-mochi__ear{animation:none!important;translate:0 1px;rotate:calc(var(--oreja,1)*-3deg);}' +
                    '.vp-mochi[data-state="desactivandoLectura"] .vp-mochi__face{animation:vp-mochi-reading-return .6s ease-out both;}' +
                    '.vp-mochi[data-sleepy-speaking="true"] .vp-mochi__eye{animation:vp-mochi-sleepy-speaking-eyes 1.96s ease-in-out both!important;}' +
                    '@keyframes vp-mochi-next-tilt{0%{transform:rotate(0) translateY(0);}28%{transform:rotate(12deg) translateY(-3px);}58%{transform:rotate(8deg) translateY(-1px);}100%{transform:rotate(0) translateY(0);}}' +
                    '@keyframes vp-mochi-prev-tilt{0%{transform:rotate(0) translateY(0);}28%{transform:rotate(-12deg) translateY(-3px);}58%{transform:rotate(-8deg) translateY(-1px);}100%{transform:rotate(0) translateY(0);}}' +
                    '@keyframes vp-mochi-next-anticipate{0%{transform:rotate(0) translateY(0);}72%,100%{transform:rotate(7deg) translateY(-1px);}}' +
                    '@keyframes vp-mochi-prev-anticipate{0%{transform:rotate(0) translateY(0);}72%,100%{transform:rotate(-7deg) translateY(-1px);}}' +
                    '@keyframes vp-mochi-video-rebound{0%{transform:translateY(3px) scale(1.08,.9);}38%{transform:translateY(-8px) scale(.94,1.1);}68%{transform:translateY(1px) scale(1.04,.97);}100%{transform:translateY(0) scale(1);}}' +
                    '@keyframes vp-mochi-detectar-capitulos{0%{transform:rotate(0) translateY(0) scale(1);}24%{transform:rotate(10deg) translateY(-2px) scale(1.02);}52%{transform:rotate(7deg) translateY(0) scale(1);}78%{transform:rotate(2deg) translateY(-1px);}100%{transform:rotate(0) translateY(0) scale(1);}}' +
                    '@keyframes vp-mochi-mirada-capitulos{0%,18%{transform:translateY(0) scaleY(1);}48%,72%{transform:translateY(1.5px) scaleY(.84);}100%{transform:translateY(0) scaleY(1);}}' +
                    '@keyframes vp-mochi-translation-nod{0%,100%{transform:translateY(0) rotate(0);}35%{transform:translateY(2px) rotate(5deg);}68%{transform:translateY(1px) rotate(3deg);}}' +
                    '@keyframes vp-mochi-translation-look{0%,20%,100%{transform:translateY(0) scaleY(1);}55%,76%{transform:translateY(1.5px) scaleY(.82);}}' +
                    '@keyframes vp-mochi-translation-bulb{0%{opacity:0;transform:scale(.45);}28%,76%{opacity:1;transform:scale(1.1);}100%{opacity:.6;transform:scale(1);}}' +
                    '@keyframes vp-mochi-translation-surprise{0%{transform:translateY(0) scale(1);}20%{transform:translateY(3px) scale(1.08,.88);}48%{transform:translateY(-8px) scale(.94,1.1);}74%{transform:translateY(1px) scale(1.04,.97);}100%{transform:translateY(0) scale(1);}}' +
                    '@keyframes vp-mochi-translation-question{0%{opacity:0;transform:translate(-50%,8px) scale(.4) rotate(-15deg);}32%{opacity:1;transform:translate(-50%,-2px) scale(1.12) rotate(7deg);}100%{opacity:0;transform:translate(-50%,-18px) scale(.9) rotate(0);}}' +
                    '@keyframes vp-mochi-chat-presence{0%,100%{transform:translateY(0) rotate(0) scale(1);}50%{transform:translateY(-1.5px) rotate(1.5deg) scale(1.015,.99);}}' +
                    '@keyframes vp-mochi-chat-entry{0%{transform:translateY(2px) scale(.9);}45%{transform:translateY(-1px) scale(1.06);}100%{transform:translateY(0) scale(1);}}' +
