                    '@keyframes vp-mochi-frame-pose{0%{transform:rotate(-5deg) translateY(2px) scale(.97,1.02);}35%{transform:rotate(2deg) translateY(-3px) scale(1.02,.98);}65%,100%{transform:rotate(0) translateY(-1px) scale(1.02,.98);}}' +
                    '@keyframes vp-mochi-frame-glint{0%,25%{opacity:0;transform:translate(-50%,5px) scale(.3) rotate(-25deg);}58%{opacity:1;transform:translate(-50%,-2px) scale(1.2) rotate(10deg);}100%{opacity:.75;transform:translate(-50%,-4px) scale(1) rotate(0);}}' +
                    '@keyframes vp-mochi-mode-look{0%,100%{transform:rotate(0) translateY(0);}18%{transform:rotate(-8deg) translateY(-1px);}42%{transform:rotate(7deg) translateY(0);}68%{transform:rotate(-3deg) translateY(-1px);}}' +
                    '@keyframes vp-mochi-mode-eyes{0%,100%{transform:translateX(0);}25%{transform:translateX(-1.5px);}52%{transform:translateX(1.5px);}76%{transform:translateX(0);}}' +
                    '@keyframes vp-mochi-mode-pip{0%{transform:scale(1);opacity:.9;}65%,100%{transform:scale(.72);opacity:.42;}}' +
                    '@keyframes vp-mochi-mode-fullscreen{0%{transform:scale(1);opacity:.7;}65%,100%{transform:scale(1.14);opacity:1;}}' +
                    '@keyframes vp-mochi-mode-theatre{0%{transform:translateX(-50%) scaleX(1);opacity:.75;}65%,100%{transform:translateX(-50%) scaleX(1.3);opacity:1;}}' +
                    '@keyframes vp-mochi-hdr-flash{0%{filter:brightness(1);}18%{filter:brightness(1.75) saturate(1.12);}42%{filter:brightness(1.32);}72%{filter:brightness(1.08);}100%{filter:brightness(1);}}' +
                    '@keyframes vp-mochi-hdr-eyes{0%,18%{transform:scaleY(1);}32%{transform:scaleY(.28);}52%,100%{transform:scaleY(1);}}' +
                    '@keyframes vp-mochi-hdr-aura{0%{transform:scale(1);opacity:.65;filter:brightness(1);}18%{transform:scale(1.24);opacity:1;filter:brightness(1.9) drop-shadow(0 0 11px rgba(255,238,158,.98));}62%,100%{transform:scale(1.08);opacity:.92;filter:brightness(1.5) drop-shadow(0 0 7px rgba(255,238,158,.85));}}' +
                    '@keyframes vp-mochi-loop-tail{0%,100%{transform:rotate(0);}22%{transform:rotate(25deg) translateY(-1px);}48%{transform:rotate(-18deg);}74%{transform:rotate(14deg);}}' +
                    '@keyframes vp-mochi-loop-body{0%,100%{transform:translateY(0);}35%{transform:translateY(-2px);}65%{transform:translateY(0);}}' +
